APP_NAME="Drop Picture"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Temps réel des groupes — « pusher » vise le Soketi de la pile ;
# « log » coupe le temps réel sans rien casser.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=drop-picture
PUSHER_APP_KEY=drop-picture-local
PUSHER_APP_SECRET=secret-local
PUSHER_HOST=drop-soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
# Ce que voit le navigateur en local (vide en production : même domaine, wss).
PUSHER_CLIENT_HOST=localhost
PUSHER_CLIENT_PORT=6001
PUSHER_CLIENT_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

APP_PORT=8080
VITE_PORT=5174
FORWARD_DB_PORT=33061

# Inscriptions libres ; à passer à false pour ne laisser entrer que les invités.
DROP_REGISTRATION_OPEN=true

# Espace par compte et taille maximale d'un fichier, en octets (100 Go / 50 Go),
# et réserve à laisser libre sur le disque (5 Go).
DROP_QUOTA_BYTES=107374182400
DROP_MAX_FILE_BYTES=53687091200
DROP_DISK_RESERVE_BYTES=5368709120

# Archivage sans perte des photos restées sans consultation (jours ; 0 = jamais).
# JPEG → JPEG XL (~20 % gagnés), RAW/TIFF/PNG → zstd ; l'original se reconstruit
# à l'identique au téléchargement. Réglable aussi depuis l'application.
DROP_ARCHIVE_AFTER_DAYS=7

# Binaires vidéo : vides ou absents, les vidéos sont acceptées sans aperçu.
DROP_FFPROBE=ffprobe
DROP_FFMPEG=ffmpeg
