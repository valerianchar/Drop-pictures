# Modèle de configuration pour une mise en ligne.
# Copiez-le en .env sur le serveur (/srv/drop-picture/.env), puis remplissez
# chaque valeur marquée À REMPLIR.

APP_NAME="Drop Picture"
APP_ENV=production
# À REMPLIR : php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# À REMPLIR : l'adresse publique, en https, sans barre oblique finale.
APP_URL=https://drop-pictures.vallau.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Domaine de l'application : c'est le Traefik du serveur qui obtient son certificat.
APP_DOMAIN=drop-pictures.vallau.com
# À REMPLIR : adresse prévenue par Let's Encrypt avant expiration.
TLS_EMAIL=vous@exemple.fr

# Derrière le Traefik du serveur, l'application doit faire confiance aux
# en-têtes X-Forwarded-* venus du réseau « proxy », dont le sous-réseau est fixé
# à la création : 172.30.0.0/24.
TRUSTED_PROXIES=172.30.0.0/24

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=drop_picture
DB_USERNAME=drop_picture
# À REMPLIR : openssl rand -base64 24
DB_PASSWORD=
# À REMPLIR : openssl rand -base64 24
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Le cookie de session ne doit jamais circuler en clair.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
# Les aperçus se calculent dans le conteneur « queue » : la file est en base.
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Inscriptions libres ; à passer à false pour ne laisser entrer que les invités
# (les liens d'invitation de groupe restent honorés).
DROP_REGISTRATION_OPEN=true

# Espace par compte et taille maximale d'un fichier, en octets (10 Go / 5 Go).
# Le volume docker « storage » doit pouvoir les contenir : vérifiez le disque.
DROP_QUOTA_BYTES=10737418240
DROP_MAX_FILE_BYTES=5368709120

# Envoi d'e-mails — invitations de groupe et réinitialisation de mot de passe.
# Par défaut, les messages vont dans le Mailpit de la pile (tunnel SSH sur le
# port 8026, voir compose.deploy.yaml) : rien ne part sur Internet. Pour que
# les invités reçoivent vraiment leur e-mail, remplacez par un SMTP externe —
# par exemple Brevo (gratuit, 300 e-mails/jour) : MAIL_HOST smtp-relay.brevo.com,
# MAIL_PORT 587, MAIL_SCHEME tls, et les identifiants SMTP du compte.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=drop-picture@localhost
MAIL_FROM_NAME="${APP_NAME}"

# Interface web de Mailpit sur un sous-domaine, via Traefik. Créez d'abord
# l'enregistrement DNS A du sous-domaine vers l'IP du serveur. L'accès est
# protégé par mot de passe ; générez le haché avec :
#   docker run --rm httpd:2 htpasswd -nbB admin 'VOTRE_MOT_DE_PASSE'
# ATTENTION : doublez chaque « $ » du haché avant de le coller ici ($ → $$).
# Laissés vides, seul le tunnel SSH donne accès à l'interface — et MAILPIT_TRAEFIK
# reste à false : Traefik n'expose pas Mailpit et ne demande aucun certificat.
MAILPIT_TRAEFIK=false
MAILPIT_DOMAIN=
MAILPIT_BASIC_AUTH=
