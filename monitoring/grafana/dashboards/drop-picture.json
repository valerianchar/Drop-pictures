{
    "title": "Drop Picture",
    "uid": "drop-picture",
    "tags": ["drop-picture", "traefik", "cadvisor"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "editable": true,
    "refresh": "30s",
    "time": { "from": "now-6h", "to": "now" },
    "templating": { "list": [] },
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Requêtes / s",
            "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                { "refId": "A", "expr": "sum(rate(traefik_service_requests_total{service=\"drop-picture@docker\"}[5m]))" }
            ],
            "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
            "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Erreurs 5xx / s",
            "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                { "refId": "A", "expr": "sum(rate(traefik_service_requests_total{service=\"drop-picture@docker\", code=~\"5..\"}[5m])) or vector(0)" }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "decimals": 3,
                    "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] }
                }
            },
            "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Latence p95",
            "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=\"drop-picture@docker\"}[5m])))"
                }
            ],
            "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 } },
            "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
        },
        {
            "id": 4,
            "type": "stat",
            "title": "Certificat TLS — jours restants",
            "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [{ "refId": "A", "expr": "min(traefik_tls_certs_not_after - time()) / 86400" }],
            "fieldConfig": {
                "defaults": {
                    "unit": "d",
                    "decimals": 0,
                    "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 7 }, { "color": "green", "value": 20 }] }
                }
            },
            "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Débit — dépôts (entrant) et téléchargements (sortant)",
            "description": "Les fichiers partent tels quels : le débit sortant est celui des originaux.",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                { "refId": "A", "legendFormat": "Dépôts (entrant)", "expr": "sum(rate(traefik_service_requests_bytes_total{service=\"drop-picture@docker\"}[5m]))" },
                { "refId": "B", "legendFormat": "Téléchargements (sortant)", "expr": "sum(rate(traefik_service_responses_bytes_total{service=\"drop-picture@docker\"}[5m]))" }
            ],
            "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 12, "lineWidth": 2 } } },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Codes de réponse",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                { "refId": "A", "legendFormat": "{{code}}", "expr": "sum by (code) (rate(traefik_service_requests_total{service=\"drop-picture@docker\"}[5m]))" }
            ],
            "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 12, "lineWidth": 2, "stacking": { "mode": "normal" } } } },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "Latence de l'application",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=\"drop-picture@docker\"}[5m])))" },
                { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=\"drop-picture@docker\"}[5m])))" },
                { "refId": "C", "legendFormat": "p99", "expr": "histogram_quantile(0.99, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=\"drop-picture@docker\"}[5m])))" }
            ],
            "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
        },
        {
            "id": 8,
            "type": "timeseries",
            "title": "Mémoire des conteneurs",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                { "refId": "A", "legendFormat": "{{name}}", "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"drop-picture-.*\"})" }
            ],
            "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 8 } } },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
        },
        {
            "id": 9,
            "type": "timeseries",
            "title": "Processeur des conteneurs",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                { "refId": "A", "legendFormat": "{{name}}", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"drop-picture-.*\"}[5m]))" }
            ],
            "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "lineWidth": 2, "fillOpacity": 8 } } },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
        },
        {
            "id": 10,
            "type": "timeseries",
            "title": "Disque du volume storage (écritures)",
            "description": "Les originaux s'accumulent sur le volume « storage » : à surveiller avec l'espace disque de la machine.",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "targets": [
                { "refId": "A", "legendFormat": "{{name}}", "expr": "sum by (name) (rate(container_fs_writes_bytes_total{name=~\"drop-picture-(app|queue)-1\"}[5m]))" }
            ],
            "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2, "fillOpacity": 8 } } },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
        }
    ]
}
