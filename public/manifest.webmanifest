{
    "name": "Drop Picture",
    "short_name": "Drop Picture",
    "description": "Dépose et partage tes photos et vidéos en qualité d'origine — zéro compression.",
    "lang": "fr",
    "dir": "ltr",
    "start_url": "/",
    "scope": "/",
    "id": "/",
    "display": "standalone",
    "background_color": "#0a0e0a",
